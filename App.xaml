<Application x:Class="SwiftwaveTweaks.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- Theme palette. ThemeService replaces these brushes at runtime; every template below
         references them with DynamicResource so a theme switch repaints the whole app. -->
    <SolidColorBrush x:Key="AppWindowBg" Color="#0B101A"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#101926"/>
    <SolidColorBrush x:Key="CardBg" Color="#141F2E"/>
    <SolidColorBrush x:Key="CardSoftBg" Color="#182536"/>
    <SolidColorBrush x:Key="LineBrush" Color="#243345"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F8FC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8CA0B5"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#657A90"/>
    <SolidColorBrush x:Key="TextFaint" Color="#4C5F75"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="HeaderSub" Color="#7E93A9"/>
    <SolidColorBrush x:Key="NavText" Color="#B8C5D4"/>
    <SolidColorBrush x:Key="NavTextHover" Color="#E4EDF6"/>
    <SolidColorBrush x:Key="NavTextSelected" Color="#F5F8FC"/>
    <SolidColorBrush x:Key="NavHoverFill" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="NavHighlightBrush" Color="#87A0B8"/>
    <SolidColorBrush x:Key="ButtonFill" Color="#1C2A3B"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#31455D"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#2E4259"/>
    <SolidColorBrush x:Key="ButtonPress" Color="#0D1622"/>
    <SolidColorBrush x:Key="ButtonDisabledText" Color="#7E90A3"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#31455D"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#4A637F"/>
    <SolidColorBrush x:Key="ScrollThumbDrag" Color="#5B7A9C"/>
    <SolidColorBrush x:Key="TrayMenuBg" Color="#141F2E"/>
    <SolidColorBrush x:Key="TrayMenuBorder" Color="#243345"/>
    <SolidColorBrush x:Key="TrayMenuText" Color="#F5F8FC"/>
    <SolidColorBrush x:Key="TrayHover" Color="#2E4259"/>
    <SolidColorBrush x:Key="TrayPress" Color="#1C2A3B"/>
    <SolidColorBrush x:Key="WelcomePrompt" Color="#AFC0D1"/>
    <SolidColorBrush x:Key="WelcomeName" Color="#F5FAFF"/>

    <!-- Buttons: smooth hover / pressed / disabled transitions, rounded, consistent. -->
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Background" Value="{DynamicResource ButtonFill}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
              <Border x:Name="HoverFill" Background="{DynamicResource ButtonHover}" CornerRadius="6" Opacity="0" Margin="1"/>
              <Border x:Name="PressFill" Background="{DynamicResource ButtonPress}" CornerRadius="6" Opacity="0" Margin="1"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False" SnapsToDevicePixels="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledText}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Navigation items: transparent chrome (the moving highlight shows selection),
         soft hover fill and theme-aware foreground colour. -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource NavText}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="HoverFill" Background="{DynamicResource NavHoverFill}" CornerRadius="8" Opacity="0"/>
              <ContentPresenter Margin="12,9" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource NavTextHover}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <!-- Declared after hover so a selected item keeps its selected colour while hovered. -->
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tray context menu: themed surface with rounded corners. The stock MenuItem template
         reserves an icon/check column, which rendered as two light squares beside the items. -->
    <Style x:Key="SwiftwaveTrayMenu" TargetType="{x:Type ContextMenu}">
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Background" Value="{DynamicResource TrayMenuBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TrayMenuBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource TrayMenuText}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="MinWidth" Value="168"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Grid Margin="10" SnapsToDevicePixels="True">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <StackPanel IsItemsHost="True" Margin="5" KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tray menu item: no glyph column, theme hover/pressed fills, inherits the menu font. -->
    <Style x:Key="SwiftwaveTrayMenuItem" TargetType="{x:Type MenuItem}">
      <Setter Property="Foreground" Value="{DynamicResource TrayMenuText}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type MenuItem}">
            <Border x:Name="ItemFill" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemFill" Property="Background" Value="{DynamicResource TrayHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ItemFill" Property="Background" Value="{DynamicResource TrayPress}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SwiftwaveTraySeparator" TargetType="{x:Type Separator}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Separator}">
            <Border Height="1" Margin="8,4" Background="{DynamicResource LineBrush}" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim modern scrollbar: transparent track, rounded pill thumb. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid x:Name="Root" Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Width="6" HorizontalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbFill" Background="{DynamicResource ScrollThumb}" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{DynamicResource ScrollThumbDrag}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="10"/>
        </Trigger>
      </Style.Triggers>
    </Style>

  </Application.Resources>
</Application>
